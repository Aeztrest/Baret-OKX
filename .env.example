PORT=8787
HOST=0.0.0.0

# x402 payment gate
X402_ENABLED=true
X402_PAY_TO=0xYourReceivingWalletAddress
X402_NETWORK=eip155:8453
X402_FACILITATOR_URL=https://www.x402.org/facilitator
VETRA_CHECK_PRICE=$0.01
VETRA_CHECK_PRICE_ATOMIC=10000

# Optional per-chain RPC overrides (defaults to public RPCs otherwise)
# RPC_URL_ETHEREUM=
# RPC_URL_BASE=
# RPC_URL_BASE_SEPOLIA=
# RPC_URL_POLYGON=

# Optional: JSON array of lowercase 0x addresses to treat as a blocklist
# VETRA_BLOCKLIST_URL=https://example.com/blocklist.json
