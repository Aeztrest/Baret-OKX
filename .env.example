PORT=8787
HOST=0.0.0.0
NODE_ENV=production
# Set to "true" when deployed behind a reverse proxy (Render, etc.) so
# rate-limiting and logs see the real client IP instead of the proxy's.
TRUST_PROXY=true

# x402 payment gate
X402_ENABLED=true
X402_PAY_TO=0xYourReceivingWalletAddress
X402_NETWORK=eip155:8453
X402_FACILITATOR_URL=https://www.x402.org/facilitator
BARET_CHECK_PRICE=$0.01

# Optional per-chain RPC overrides (defaults to public RPCs otherwise)
# RPC_URL_ETHEREUM=
# RPC_URL_BASE=
# RPC_URL_BASE_SEPOLIA=
# RPC_URL_POLYGON=

# Optional: JSON array of lowercase 0x addresses to treat as a blocklist
# BARET_BLOCKLIST_URL=https://example.com/blocklist.json
